# Скопируй этот файл в .env и заполни реальными значениями.
# .env в .gitignore — никогда не коммить реальные пароли.

GOOGLE_CLOUD_PROJECT=

# Доступ для деплоя (deploy.js) — данные из панели NetAngels:
# panel.netangels.ru/hosting/ -> контейнер -> вкладка "доступ SSH/FTP"
# Протокол: ftp (FTP-аккаунт сайта, root=/www) или sftp (SSH-логин контейнера).
DEPLOY_PROTOCOL=ftp
DEPLOY_HOST=
DEPLOY_PORT=21
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_REMOTE_DIR=/www
# Файлы крупнее этого размера (МБ) пропускаются — заливай их вручную.
DEPLOY_MAX_SIZE_MB=50

# SFTP-настройки (используются, когда DEPLOY_PROTOCOL=sftp). Заданы — берутся вместо
# общих DEPLOY_* выше, так что оба набора живут рядом и переключение — только смена
# DEPLOY_PROTOCOL. Логин SFTP — общий SSH-логин контейнера (cXXXXXX), НЕ аккаунт сайта.
# REMOTE_DIR у SSH другой: не /www, а полный путь до корня сайта внутри контейнера.
DEPLOY_SFTP_HOST=
DEPLOY_SFTP_PORT=22
DEPLOY_SFTP_USER=
DEPLOY_SFTP_PASSWORD=
DEPLOY_SFTP_REMOTE_DIR=
