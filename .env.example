# Скопируй этот файл в .env и заполни реальными значениями.
# .env в .gitignore — никогда не коммить реальные пароли.

GOOGLE_CLOUD_PROJECT=

# Доступ для деплоя (deploy.js) — данные из панели NetAngels:
# panel.netangels.ru/hosting/ -> контейнер -> вкладка "доступ SSH/FTP" -> "Сменить пароль"
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_REMOTE_DIR=/home/c112136/lazurprint.ru/www
